#include<iostream>
#include<iomanip>
using namespace std;

int main() {

    string name;
    int s1, s2, s3, s4, s5;
    int total;
    float percentage;

    cout << "===== STUDENT RESULT SYSTEM =====" << endl;

    cout << "Enter Student Name: ";
    cin >> name;

    cout << "Enter marks for 5 subjects:" << endl;

    cout << "Subject 1: ";
    cin >> s1;

    cout << "Subject 2: ";
    cin >> s2;

    cout << "Subject 3: ";
    cin >> s3;

    cout << "Subject 4: ";
    cin >> s4;

    cout << "Subject 5: ";
    cin >> s5;

    total = s1 + s2 + s3 + s4 + s5;

    percentage = total / 5.0;

    cout << "\n===== RESULT =====" << endl;

    cout << "Student Name : " << name << endl;
    cout << "Total Marks  : " << total << "/500" << endl;

    cout << fixed << setprecision(2);
    cout << "Percentage   : " << percentage << "%" << endl;

    if(percentage >= 90) {
        cout << "Grade        : A+" << endl;
        cout << "Result       : Outstanding" << endl;
    }
    else if(percentage >= 75) {
        cout << "Grade        : A" << endl;
        cout << "Result       : Excellent" << endl;
    }
    else if(percentage >= 60) {
        cout << "Grade        : B" << endl;
        cout << "Result       : Good" << endl;
    }
    else if(percentage >= 40) {
        cout << "Grade        : C" << endl;
        cout << "Result       : Pass" << endl;
    }
    else {
        cout << "Grade        : F" << endl;
        cout << "Result       : Fail" << endl;
    }

    if(s1 < 35 || s2 < 35 || s3 < 35 || s4 < 35 || s5 < 35) {
        cout << "Status       : Failed in one or more subjects" << endl;
    }
    else {
        cout << "Status       : Passed in all subjects" << endl;
    }

    return 0;
}
